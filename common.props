<Project>
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<!-- KeviMultiTarget=true を import 前に設定したプロジェクトのみ Windows ネイティブ通知用 TFM を併せ持つ -->
		<TargetFramework Condition="'$(KeviMultiTarget)' != 'true'">net10.0</TargetFramework>
		<!-- IDE のデバッグ実行は先頭 TFM が既定になるため、ホスト OS に応じて並べる。
		     Windows ではトースト対応の windows TFM を先頭にしないと #if WINDOWS が無効になり通知/トレイが動かない。
		     CI の publish は -f で明示するため並び順の影響を受けない。 -->
		<TargetFrameworks Condition="'$(KeviMultiTarget)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(KeviMultiTarget)' == 'true' and !$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- 基本バージョン設定 -->
		<Version Condition="'$(APP_VERSION)' != ''">$(APP_VERSION)</Version>
		<Version Condition="'$(APP_VERSION)' == ''">0.1.1</Version>
		
		<!-- BUILD_NUMBER設定 -->
		<BuildNumber Condition="'$(BUILD_NUMBER)' != ''">$(BUILD_NUMBER)</BuildNumber>
		<BuildNumber Condition="'$(BUILD_NUMBER)' == ''">0</BuildNumber>
		
		<!-- AssemblyVersion (4桁、既存と同じ) -->
		<AssemblyVersion>$(Version).$(BuildNumber)</AssemblyVersion>
		
		<!-- SourceLink自動バージョン付与を無効化 -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		
		<!-- AssemblyInformationalVersion (suffix対応) -->
		<AssemblyInformationalVersion Condition="'$(VERSION_SUFFIX)' == ''">$(AssemblyVersion)</AssemblyInformationalVersion>
		<AssemblyInformationalVersion Condition="'$(VERSION_SUFFIX)' != ''">$(AssemblyVersion)-$(VERSION_SUFFIX)</AssemblyInformationalVersion>

		<Nullable>enable</Nullable>

		<Product>KyoshinEewViewer for ingen</Product>
		<Authors>ingen software</Authors>

		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<DebugType>embedded</DebugType>

        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<EventSourceSupport>false</EventSourceSupport>
		<InvariantGlobalization>false</InvariantGlobalization>

		<!-- 不要なフレームワーク機能を無効化してサイズを削減 -->
		<!-- HttpActivityPropagationSupport は Sentry の HTTP トレース伝播に、
		     AutoreleasePoolSupport は macOS スレッドプールの安全性に必要なため無効化しない -->
		<DebuggerSupport>false</DebuggerSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>

        <PublishReadyToRun>true</PublishReadyToRun>

		<!-- opt-in 部分トリム: IsTrimmable 属性のあるアセンブリだけがトリム対象 -->
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <StripSymbols>false</StripSymbols>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>

        <DefineConstants Condition="$(RuntimeIdentifier.StartsWith('linux'))">LINUX</DefineConstants>
	</PropertyGroup>
	
	<PropertyGroup>
        <AvaloniaVersion>12.0.4</AvaloniaVersion>
        <SplatVersion>19.4.1</SplatVersion>
        <DotnetVersion>10.0.9</DotnetVersion>
    </PropertyGroup>

	<!-- NuGet -->
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.2" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
		<PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" />
		<PackageReference Include="FluentAvaloniaUI" Version="3.0.0-preview4" />

        <PackageReference Include="Splat" Version="$(SplatVersion)" />
        <PackageReference Include="Splat.DependencyInjection.SourceGenerator" Version="2.3.0" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

		<PackageReference Condition="$(RuntimeIdentifier.StartsWith('linux'))" Include="Mono.Posix.NETStandard" Version="1.0.0" />

        <PackageReference Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" Include="Microsoft.Extensions.Logging" Version="$(DotnetVersion)" />
		<PackageReference Include="NReco.Logging.File" Version="1.3.1" />

		<PackageReference Include="KyoshinMonitorLib" Version="0.4.5.2" />
		<PackageReference Include="KyoshinMonitorLib.SkiaImages" Version="0.4.5.2" />
		<PackageReference Include="KyoshinMonitorLib.Timers" Version="0.4.5.2" />
		<PackageReference Include="DmdataSharp" Version="0.6.0.2" />
	</ItemGroup>

	<!-- Splat.DependencyInjection.SourceGenerator の名前空間衝突ワークアラウンド -->
	<ItemGroup>
		<Compile Include="$(MSBuildThisFileDirectory)SplatSourceGeneratorWorkaround.cs" Link="SplatSourceGeneratorWorkaround.cs" />
	</ItemGroup>
</Project>
