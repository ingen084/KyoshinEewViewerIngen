<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converter="clr-namespace:KyoshinEewViewer.Converters"
			 xmlns:cc="clr-namespace:KyoshinEewViewer.CustomControl;assembly=KyoshinEewViewer.CustomControl"
			 xmlns:series="clr-namespace:KyoshinEewViewer.Series;assembly=KyoshinEewViewer"
			 xmlns:vm="using:KyoshinEewViewer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
			 x:DataType="vm:MainViewModel" x:CompileBindings="True"
             x:Class="KyoshinEewViewer.Views.MainView"
			 Background="{DynamicResource TitleBackgroundColor}" Foreground="{DynamicResource MainForegroundColor}">
    <UserControl.Resources>
        <converter:MiniMapPathConverter x:Key="MiniMapPathConverter" />
        <converter:ThicknessScaleConverter x:Key="ThicknessScaleConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- サイドバー項目のスタイル -->
        <Style Selector="ListBox.navSidebar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.navSidebar ListBoxItem">
            <Setter Property="Width" Value="64" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="LayoutRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            TemplatedControl.IsTemplateFocusTarget="True">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Duration="00:00:00.083" Property="Background" />
                            </Transitions>
                        </Border.Transitions>
                        <Panel>
                            <Panel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Name="SelectionIndicator"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Width="3"
                                        Opacity="0"
                                        VerticalAlignment="Center"
                                        Height="20"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Duration="00:00:00.167" Property="Opacity" Easing="CubicEaseOut" />
                                            <DoubleTransition Duration="00:00:00.167" Property="Height" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                            </Panel>
                            <DockPanel>
                                <TextBlock Name="ContentText"
                                           Text="{Binding Meta.Name}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           TextAlignment="Center"
                                           FontSize="11"
                                           Padding="0,4"
                                           Margin="0,-10,0,3"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubForegroundColor}"
                                           DockPanel.Dock="Bottom" />

                                <Viewbox Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <TextBlock Name="IconText"
                                               Text="{Binding Meta.IconGlyph}"
                                               FontFamily="{StaticResource IconFont}"
                                               Foreground="{DynamicResource SubForegroundColor}" />
                                </Viewbox>
                            </DockPanel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- ホバー -->
        <Style Selector="ListBox.navSidebar ListBoxItem:pointerover /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.navSidebar ListBoxItem:pointerover /template/ TextBlock#ContentText">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.navSidebar ListBoxItem:pointerover /template/ TextBlock#IconText">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- プレス -->
        <Style Selector="ListBox.navSidebar ListBoxItem:pressed /template/ TextBlock#ContentText">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.navSidebar ListBoxItem:pressed /template/ TextBlock#IconText">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- 選択時: アクセントカラーバーのアニメーション -->
        <Style Selector="ListBox.navSidebar ListBoxItem:selected /template/ Border#SelectionIndicator">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="ListBox.navSidebar ListBoxItem:selected /template/ TextBlock#ContentText">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.navSidebar ListBoxItem:selected /template/ TextBlock#IconText">
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <!-- ミュートアイコンのスタイル -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource EmphasisForegroundColor}" />
        </Style>
    </UserControl.Styles>
    <LayoutTransformControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </LayoutTransformControl.LayoutTransform>
        <Panel>
            <SplitView Name="NavSplitView"
                       IsPaneOpen="{Binding IsSidebarVisible}"
                       DisplayMode="CompactInline"
                       OpenPaneLength="64"
                       CompactPaneLength="0"
                       PanePlacement="Left"
                       Margin="0,-1,0,0">
                <SplitView.Pane>
                    <Panel Margin="0,0,0,100">
                        <ListBox Classes="navSidebar"
                                 ItemsSource="{Binding SeriesController.EnabledSeries}"
                                 SelectedItem="{Binding SelectedSeries, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="series:SeriesBase">
                                    <Setter Property="IsVisible" Value="{Binding !IsSeparated}" />
                                </Style>
                                <Style Selector="ListBoxItem.multiwindow" x:DataType="series:SeriesBase">
                                    <Setter Property="ContextFlyout">
                                        <MenuFlyout>
                                            <MenuItem Header="別ウィンドウで開く"
                                                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SeparateSeries}"
                                                      CommandParameter="{Binding}" />
                                        </MenuFlyout>
                                    </Setter>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="series:SeriesBase">
                                    <Panel />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </SplitView.Pane>

                <Panel Background="{DynamicResource MainBackgroundColor}">
                    <cc:MapControl Name="Map"
                                   ClipToBounds="True"
                                   MinZoom="3"
                                   MaxNavigateZoom="{Binding MaxMapNavigateZoom}"
                                   Layers="{Binding MapLayers}"
                                   IsMetricsEnabled="{Binding IsMetricsEnabled, Mode=OneWay}"
                                   LatestMetrics="{Binding LatestMetrics, Mode=OneWayToSource}"
                                   IsInertiaEnabled="{Binding Config.Map.IsInertiaEnabled}">
                        <cc:MapControl.Padding>
                            <MultiBinding Converter="{StaticResource ThicknessScaleConverter}">
                                <Binding Path="MapPadding" />
                                <Binding Path="EffectiveScale" ElementName="SeriesScaleBox" />
                            </MultiBinding>
                        </cc:MapControl.Padding>
                    </cc:MapControl>
                    <Grid Name="MiniMapContainer" Margin="{Binding MapPadding}" ColumnDefinitions="5*,6*" RowDefinitions="5*,6*">
                        <Panel Name="MiniMapPanel" Margin="5" MaxWidth="400" MaxHeight="300">
                            <Border Name="MiniMapBackgroundBorder" Background="{DynamicResource MainBackgroundColor}">
                                <Border.Clip>
                                    <MultiBinding Converter="{StaticResource MiniMapPathConverter}">
                                        <Binding Path="Bounds.Width" ElementName="MiniMapBackgroundBorder" />
                                        <Binding Path="Bounds.Height" ElementName="MiniMapBackgroundBorder" />
                                    </MultiBinding>
                                </Border.Clip>
                                <cc:MapControl Name="MiniMap"
                                               MinZoom="1"
                                               Layers="{Binding MapLayers}"
                                               IsDisableManualControl="True" />
                            </Border>
                            <Path Stroke="{DynamicResource SubForegroundColor}" StrokeThickness="1" Fill="Transparent">
                                <Path.Data>
                                    <MultiBinding Converter="{StaticResource MiniMapPathConverter}">
                                        <Binding Path="Bounds.Width" ElementName="MiniMapPanel" />
                                        <Binding Path="Bounds.Height" ElementName="MiniMapPanel" />
                                    </MultiBinding>
                                </Path.Data>
                            </Path>
                        </Panel>
                    </Grid>
                    <cc:MinScaleViewbox Name="SeriesScaleBox"
                                        MinViewWidth="{Binding SelectedSeries.MinViewSize.Width}"
                                        MinViewHeight="{Binding SelectedSeries.MinViewSize.Height}">
                        <ContentControl Name="FrameView" Content="{Binding DisplayControl}"/>
                    </cc:MinScaleViewbox>
                    <Border IsVisible="{Binding UpdateAvailableWithDelay}"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Margin="10,0,0,10"
                            MaxWidth="320"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            Padding="16,12"
                            BoxShadow="0 8 32 0 #44000000">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="アプリケーションの更新があります"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Command="{Binding DismissUpdateNotification}"
                                    Theme="{StaticResource TransparentButton}"
                                    Padding="4"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xf00d;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                            </Button>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="設定画面から詳細の確認ができます"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <Button Grid.Row="2" Grid.ColumnSpan="2"
                                    Content="設定画面を開く"
                                    Command="{Binding ShowSettingWindow}"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </Panel>
            </SplitView>

            <Panel Width="64" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding IsSidebarVisible}">
                <StackPanel HorizontalAlignment="Center" Spacing="3" Opacity="{Binding LeftBottomControlOpacity}" >
                    <Button Name="MuteButton" Command="{Binding ToggleMute}" Padding="10,7" Theme="{StaticResource TransparentButton}" ToolTip.Tip="音声をミュート" IsVisible="{Binding Config.Audio.ShowMuteButtonInMainWindow}">
                        <Viewbox Height="28" Margin="0,2">
                            <TextBlock Text="{Binding Config.Audio.IsMuted, Converter={x:Static converter:BoolToStringConverter.VolumeIcon}}" FontFamily="{StaticResource IconFont}" Classes.muted="{Binding Config.Audio.IsMuted}" />
                        </Viewbox>
                    </Button>
                    <Button Name="HomeButton" Command="{Binding ReturnToHomeMap}" Padding="10,7" Theme="{StaticResource TransparentButton}" ToolTip.Tip="地図の座標を戻す">
                        <Viewbox Height="28" Margin="0,2">
                            <TextBlock Text="&#xf015;" FontFamily="{StaticResource IconFont}" />
                        </Viewbox>
                    </Button>
                    <Button Name="OpenSettingWindowButton" Command="{Binding ShowSettingWindow}" Padding="10,7" Theme="{StaticResource TransparentButton}" ToolTip.Tip="設定画面を開く">
                        <Panel>
                            <Viewbox Height="28" Margin="0,2">
                                <TextBlock Text="&#xf013;" FontFamily="{StaticResource IconFont}" />
                            </Viewbox>
                            <Border IsVisible="{Binding UpdateAvailable}" Width="8" Height="8" CornerRadius="4"
                                    Background="{DynamicResource SystemFillColorCautionBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-5,0" />
                        </Panel>
                    </Button>
                    <TextBlock Text="{Binding Version, StringFormat={}v{0}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="8"
                               IsVisible="{Binding !IsStandalone}"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
        </Panel>
    </LayoutTransformControl>
</UserControl>
