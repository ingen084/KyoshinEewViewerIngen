<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:AvalonEdit="using:AvaloniaEdit"
        xmlns:components="clr-namespace:KyoshinEewViewer.Views.Components"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="KyoshinEewViewer.Views.Components.TemplateEditorDialog"
        x:DataType="components:TemplateEditorDialogViewModel" x:CompileBindings="True"
        Title="テンプレート編集"
        Width="900" Height="650"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="False">
    
    <Grid RowDefinitions="*,Auto">
        <!-- エディタ部分 -->
        <DockPanel Grid.Row="0" Margin="16">
            <!-- ヘッダー -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Scribanテンプレート言語を使用して動的なコンテンツを作成できます" 
                          FontSize="12" Opacity="0.7" Margin="0,4,0,0" />
            </StackPanel>
            
            <!-- エディタ -->
            <AvalonEdit:TextEditor Name="Editor"
                                   BorderThickness="1" 
                                   BorderBrush="{DynamicResource SubForegroundColor}" 
                                   CornerRadius="4"
                                   ShowLineNumbers="True"
                                   FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   FontSize="14"
                                   WordWrap="False">
            </AvalonEdit:TextEditor>
        </DockPanel>
        
        <!-- ボタン部分 -->
        <Border Grid.Row="1" 
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SubForegroundColor}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right" 
                       Margin="16,12">
                <Button Content="キャンセル" 
                       Click="CancelButton_Click"
                       Margin="0,0,8,0" />
                <Button Content="OK" 
                       Classes="accent"
                       Click="OkButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>