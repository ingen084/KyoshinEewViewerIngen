<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:KyoshinEewViewer.ViewModels"
			 xmlns:cc="using:KyoshinEewViewer.CustomControl"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
			 x:DataType="vm:SettingWindowViewModel" x:CompileBindings="True"
             x:Class="KyoshinEewViewer.Views.SettingPages.NotifyPage">
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="cc|SettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel>
            <StackPanel IsVisible="{Binding IsWindows}">
                <TextBlock Text="トレイアイコン" FontWeight="Bold" Margin="10,20,10,5" />
                <cc:SettingsExpander Header="タスクトレイのアイコンを利用する" Description="(再起動後反映)タスクトレイのアイコンがない場合通知は利用できません。" IconGlyph="&#xf86d;">
                    <cc:SettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Notification.TrayIconEnable}" OnContent="する" OffContent="しない" />
                    </cc:SettingsExpander.Footer>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="ウィンドウ格納設定" IsExpanded="True" IconGlyph="&#xf2d2;">

                    <cc:SettingsExpanderItem Content="最小化時にタスクトレイに収納する" IsEnabled="{Binding !Config.MultiWindow.Enable}">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding Config.Notification.HideWhenMinimizeWindow}" OnContent="する" OffContent="しない" IsEnabled="{Binding !Config.MultiWindow.Enable}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="ウィンドウを閉じようとした際にタスクトレイに収納する" IsEnabled="{Binding !Config.MultiWindow.Enable}">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding Config.Notification.HideWhenClosingWindow}" OnContent="する" OffContent="しない" IsEnabled="{Binding !Config.MultiWindow.Enable}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:InfoBar IsOpen="{Binding Config.MultiWindow.Enable}"
                                IsClosable="False"
                                Severity="Informational"
                                Title="マルチウィンドウ機能が有効です"
                                Message="マルチウィンドウ機能が有効な場合、ウィンドウをタスクトレイに収納する機能は利用できません。"
                                Margin="0,5,0,0" />

                    <cc:SettingsExpanderItem Content="起動時に最小化状態で起動する">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding Config.Notification.MinimizeWindowOnStartup}" OnContent="する" OffContent="しない" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="タスクトレイ格納時に通知する">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding Config.Notification.HideToTrayNotify}" OnContent="通知する" OffContent="通知しない" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>
            </StackPanel>

            <TextBlock Text="通知" FontWeight="Bold" Margin="10,20,10,5" />
            <cc:SettingsExpander Header="通知機能を利用する" Description="試験的な実装のため、バージョンアップで利用できなくなる可能性があります。" IsExpanded="True" IconGlyph="&#xf075;">
                <cc:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Notification.TrayIconEnable}" OnContent="する" OffContent="しない" />
                </cc:SettingsExpander.Footer>

                <cc:SettingsExpanderItem Content="地震情報ソース変更時">
                    <cc:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Notification.SwitchEqSource}" OnContent="通知する" OffContent="通知しない" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>

                <cc:SettingsExpanderItem Content="地震情報受信時">
                    <cc:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Notification.GotEq}" OnContent="通知する" OffContent="通知しない" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>

                <cc:SettingsExpanderItem Content="緊急地震速報更新時">
                    <cc:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Notification.EewReceived}" OnContent="通知する" OffContent="通知しない" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>

                <cc:SettingsExpanderItem Content="津波情報更新時">
                    <cc:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Notification.Tsunami}" OnContent="通知する" OffContent="通知しない" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>
            </cc:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
