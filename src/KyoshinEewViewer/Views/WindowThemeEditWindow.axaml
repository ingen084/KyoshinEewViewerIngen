<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:cc="using:KyoshinEewViewer.CustomControl"
        xmlns:converter="clr-namespace:KyoshinEewViewer.Converters;assembly=KyoshinEewViewer"
        xmlns:models="clr-namespace:KyoshinEewViewer.Core.Models;assembly=KyoshinEewViewer.Core"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="800" Width="500" Height="600"
        x:Class="KyoshinEewViewer.Views.WindowThemeEditWindow"
        x:DataType="models:WindowTheme"
        d:DataContext="{x:Static models:WindowTheme.Dark}"
        Title="ウィンドウテーマ編集" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundColor}" Foreground="{DynamicResource MainForegroundColor}">
    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="cc|SettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <converter:ColorConverter x:Key="ColorConverter" />
    </Window.Resources>

    <Grid RowDefinitions="auto,*">
        <StackPanel Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="編集中のテーマ" FontSize="18" />
            <TextBlock x:Name="themeDetailText" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        </StackPanel>
        <StackPanel Spacing="5" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button x:Name="rollbackButton" VerticalAlignment="Stretch"
                    ToolTip.Tip="復元する(ファイルの状態を読み戻す)" Padding="11">
                <TextBlock Text="&#xf0e2;" FontFamily="{StaticResource IconFont}" FontSize="18" />
            </Button>
            <Button x:Name="saveButton" VerticalAlignment="Stretch" Classes="accent"
                    ToolTip.Tip="テーマを保存する" Padding="10">
                <TextBlock Text="&#xf0c7;" FontFamily="{StaticResource IconFont}" FontSize="20" />
            </Button>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <cc:SettingsExpander Header="テーマ名" IconGlyph="&#xf5b7;">
                    <cc:SettingsExpander.Footer>
                        <TextBox Text="{Binding Name}" Width="200" />
                    </cc:SettingsExpander.Footer>
                </cc:SettingsExpander>
                <cc:SettingsExpander Header="ウィンドウ全体" IconGlyph="&#xf2d0;">
                    
                    <cc:SettingsExpanderItem Content="タイトル･サイドバーの色" Description="タイトルバー部分はWindowsでのみ反映されます。">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="ダークテーマをベースとする"
                                             Description="ボタンなどの汎用コントロールがダークテーマ基準になります。">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="する" OffContent="しない" IsChecked="{Binding IsDark}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="メイン背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MainBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="メイン文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding ForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="サブ文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SubForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="強調文字色" Description="現状では強震モニタリプレイ時の時刻色でのみ使用しています。">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EmphasisForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="エラー･警告文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="エラー･警告サブ文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningSubForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="エラー･警告背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="内部ウィンドウ(ウィジェット)" IconGlyph="&#xf2d2;">
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Margin="5" RowDefinitions="24,*">
                            <Border Grid.Row="0" Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                                <TextBlock Text="通常ウィジェット" Margin="10,0" FontSize="18" Foreground="{DynamicResource SubForegroundColor}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource DockBackgroundColor}" CornerRadius="0,0,4,4" ClipToBounds="True">
                                <TextBlock Margin="5" Text="通常ウィジェット中身" />
                            </Border>
                        </Grid>
                        <Grid Margin="5" RowDefinitions="24,*">
                            <Border Grid.Row="0" Background="{DynamicResource DockWarningTitleBackgroundColor}" CornerRadius="4,4,0,0">
                                <TextBlock Text="緊急ウィジェット" Margin="10,0" FontSize="18" Foreground="{DynamicResource WarningSubForegroundColor}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource DockWarningBackgroundColor}" CornerRadius="0,0,4,4"
                                    ClipToBounds="True">
                                <TextBlock Text="緊急ウィジェット中身" Margin="10,5" Foreground="{DynamicResource WarningForegroundColor}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                    
                    <cc:SettingsExpanderItem Content="背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="見出し部分の背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockTitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="エラー･警告の背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockWarningBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="エラー･警告の見出し部分の背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockWarningTitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="地図" IconGlyph="&#xf5a0;">
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="地図(日本国内)" />
                            <Border BorderBrush="{DynamicResource ForegroundColor}"
                                    Background="{DynamicResource BackgroundColor}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="5">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Canvas.Top="10" Canvas.Left="10" Width="100" Height="100" Stroke="{DynamicResource LandStrokeColor}" StrokeThickness="{DynamicResource LandStrokeThickness}" Fill="{DynamicResource LandColor}" />
                                    <Line Canvas.Top="10" Canvas.Left="10" StartPoint="85,15" EndPoint="15,85" Stroke="{DynamicResource PrefStrokeColor}" StrokeThickness="{DynamicResource PrefStrokeThickness}" />
                                    <Line Canvas.Top="10" Canvas.Left="10" StartPoint="15,15" EndPoint="85,85" Stroke="{DynamicResource AreaStrokeColor}" StrokeThickness="{DynamicResource AreaStrokeThickness}" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="地図(海外)" />
                            <Border BorderBrush="{DynamicResource ForegroundColor}"
                                    Background="{DynamicResource BackgroundColor}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="5">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Canvas.Top="10" Canvas.Left="10" Width="100" Height="100" Fill="{DynamicResource OverseasLandColor}" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <cc:SettingsExpanderItem Content="海外地形の色" Description="縁の設定はできません。">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding OverseasLandColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="地形の色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding LandColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="海岸線の色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding LandStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="海岸線の太さ" Description="0 にすることで描画処理を軽量化できます。">
                        <cc:SettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding LandStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding LandStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="都道府県境界線の色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding PrefStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="都道府県境界線の太さ" Description="0 にすることで描画処理を軽量化できます。">
                        <cc:SettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding PrefStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding PrefStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="地域境界線の色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AreaStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="地域境界線の太さ" Description="0 にすることで描画処理を軽量化できます。">
                        <cc:SettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding AreaStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding AreaStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="地震情報" IconGlyph="&#xf05a;">
                    
                    <cc:SettingsExpanderItem Content="震央アイコンの縁">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EarthquakeHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="震央アイコンの中央">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EarthquakeHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="緊急地震速報" IconGlyph="&#xe3b1;">
                    
                    <cc:SettingsExpanderItem Content="震央アイコンの縁(予報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="震央アイコンの中央(予報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="震央アイコンの縁(警報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="震央アイコンの中央(警報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="震央アイコンの点滅アニメーション">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="する" OffContent="しない" IsChecked="{Binding IsEewHypocenterBlinkAnimation}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="P波色(予報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastPWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="S波色(予報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastSWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="予報のS波色をグラデーションにする">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="する" OffContent="しない" IsChecked="{Binding IsEewForecastSWaveGradient}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="P波色(警報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningPWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="S波色(警報)">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningSWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="警報のS波色をグラデーションにする">
                        <cc:SettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="する" OffContent="しない" IsChecked="{Binding IsEewWarningSWaveGradient}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="津波情報" IconGlyph="&#xe515;">
                    
                    <cc:SettingsExpanderItem Content="津波予報背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiForecastColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="津波予報文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiForecastForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="津波注意報背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiAdvisoryColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="津波注意報文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiAdvisoryForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="津波警報背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiWarningColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="津波警報文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiWarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="大津波警報背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiMajorWarningColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="大津波警報文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiMajorWarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="噴火情報" Description="現状災危通報のみで使用されています。" IconGlyph="&#xf770;">
                    
                    <cc:SettingsExpanderItem Content="少量の降灰の背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallLight, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="少量の降灰の文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallLightForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="やや多量の降灰の背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallModerate, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="やや多量の降灰の文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallModerateForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="大量の降灰の背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallHeavy, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="大量の降灰の文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallHeavyForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="小さな噴石の落下の背景色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SmallVolcanicBombFall, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem Content="小さな噴石の落下の文字色">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SmallVolcanicBombFallForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="気象警報" Description="現状災危通報のみで使用されています。" IconGlyph="&#xf0c2;">

                    <cc:SettingsExpanderItem Content="警戒レベル5（特別警報）">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel5Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="警戒レベル4（危険警報･土砂災害警戒情報）">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel4Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="警戒レベル3（警報）">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel3Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="警戒レベル2（注意報）">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel2Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>

                <cc:SettingsExpander Header="海上警報" Description="現状災危通報のみで使用されています。" IconGlyph="&#xf773;">

                    <cc:SettingsExpanderItem Content="海上台風警報">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningTyphoonColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="海上暴風警報">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningStormColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="海上強風警報">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningGaleColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>

                    <cc:SettingsExpanderItem Content="海上風警報">
                        <cc:SettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningWindColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </cc:SettingsExpanderItem.Footer>
                    </cc:SettingsExpanderItem>
                </cc:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
