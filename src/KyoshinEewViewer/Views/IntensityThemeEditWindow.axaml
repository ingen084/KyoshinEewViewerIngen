<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:converter="clr-namespace:KyoshinEewViewer.Converters;assembly=KyoshinEewViewer"
        xmlns:models="clr-namespace:KyoshinEewViewer.Core.Models;assembly=KyoshinEewViewer.Core"
        xmlns:controls="clr-namespace:KyoshinEewViewer.CustomControl;assembly=KyoshinEewViewer.CustomControl"
        mc:Ignorable="d" d:DesignWidth="490" d:DesignHeight="1200" MinWidth="490" Width="500" Height="800"
        x:Class="KyoshinEewViewer.Views.IntensityThemeEditWindow"
        x:DataType="models:IntensityTheme"
        d:DataContext="{x:Static models:IntensityTheme.Standard}"
        Title="震度アイコンテーマ編集" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundColor}" Foreground="{DynamicResource MainForegroundColor}">
    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ui|SettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <converter:ColorConverter x:Key="ColorConverter" />
    </Window.Resources>

    <Grid RowDefinitions="auto,*">
        <StackPanel Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="編集中のテーマ" FontSize="18" />
            <TextBlock x:Name="themeDetailText" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        </StackPanel>
        <StackPanel Spacing="5" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button x:Name="rollbackButton" Command="" VerticalAlignment="Stretch"
                    ToolTip.Tip="復元する(ファイルの状態を読み戻す)" Padding="11">
                <ui:SymbolIcon Symbol="Undo" FontSize="18" />
            </Button>
            <Button x:Name="saveButton" VerticalAlignment="Stretch" Classes="accent"
                    ToolTip.Tip="テーマを保存する" Padding="10">
                <ui:SymbolIcon Symbol="Save" FontSize="20" />
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <ui:SettingsExpander Header="テーマ名">
                    <ui:SettingsExpander.IconSource>
                        <ui:FontIconSource Glyph="&#xf5b7;" FontFamily="{StaticResource IconFont}" />
                    </ui:SettingsExpander.IconSource>
                    <ui:SettingsExpander.Footer>
                        <TextBox Text="{Binding Name}" Width="200" />
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>

                <ui:SettingsExpander Header="縁の太さ">
                    <ui:SettingsExpander.IconSource>
                        <ui:FontIconSource Glyph="&#xf044;" FontFamily="{StaticResource IconFont}" />
                    </ui:SettingsExpander.IconSource>
                    <ui:SettingsExpander.Footer>
                        <DockPanel MinWidth="250">
                            <TextBlock Text="{Binding BorderWidthMultiply, StringFormat={}{0:0.000}}"
                                       TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                            <Slider Minimum="0" Maximum="0.3" Value="{Binding BorderWidthMultiply}"
                                    TickFrequency="0.005" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>

                <!-- 震度設定 -->
                <ui:SettingsExpander Header="震度" IsExpanded="True">
                    <ui:SettingsExpander.IconSource>
                        <ui:FontIconSource Glyph="&#xf410;" FontFamily="{StaticResource IconFont}" />
                    </ui:SettingsExpander.IconSource>
                    <StackPanel HorizontalAlignment="Stretch" Margin="-50,5,5,5" Spacing="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <controls:IntensityIcon Intensity="Unknown" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int0" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int1" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int2" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int3" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int4" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int5Lower" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int5Upper" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int6Lower" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int6Upper" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Int7" Border="True" Height="30" CornerRound="True" />
                            <controls:IntensityIcon Intensity="Error" Border="True" Height="30" CornerRound="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2.5">
                            <controls:IntensityIcon Intensity="Unknown" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int0" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int1" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int2" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int3" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int4" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int5Lower" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int5Upper" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int6Lower" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int6Upper" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Int7" Height="24" WideMode="True" />
                            <controls:IntensityIcon Intensity="Error" Height="24" WideMode="True" />
                        </StackPanel>
                    </StackPanel>

                    <ui:SettingsExpanderItem Content="不明">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding UnknownForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding UnknownBackground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding UnknownBorder, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度0">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int0Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int0Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int0Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度1">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int1Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int1Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int1Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度2">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int2Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int2Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int2Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度3">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int3Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int3Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int3Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度4">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int4Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int4Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int4Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度5弱">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int5LowerForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int5LowerBackground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int5LowerBorder, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度5強">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int5UpperForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int5UpperBackground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int5UpperBorder, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度6弱">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int6LowerForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int6LowerBackground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int6LowerBorder, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度6強">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int6UpperForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int6UpperBackground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int6UpperBorder, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="震度7">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int7Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int7Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding Int7Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="異常">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding ErrorForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding ErrorBackground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding ErrorBorder, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                </ui:SettingsExpander>

                <!-- 長周期地震動階級設定 -->
                <ui:SettingsExpander Header="長周期地震動階級">
                    <ui:SettingsExpander.IconSource>
                        <ui:FontIconSource Glyph="&#xf0c7;" FontFamily="{StaticResource IconFont}" />
                    </ui:SettingsExpander.IconSource>
                    <StackPanel HorizontalAlignment="Stretch" Margin="-50,5,5,5" Spacing="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                            <controls:LpgmIntensityIcon Intensity="Unknown" Height="30" Border="True" CornerRound="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt0" Height="30" Border="True" CornerRound="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt1" Height="30" Border="True" CornerRound="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt2" Height="30" Border="True" CornerRound="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt3" Height="30" Border="True" CornerRound="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt4" Height="30" Border="True" CornerRound="True" />
                            <controls:LpgmIntensityIcon Intensity="Error" Height="30" Border="True" CornerRound="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2.5">
                            <controls:LpgmIntensityIcon Intensity="Unknown" Height="24" WideMode="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt0" Height="24" WideMode="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt1" Height="24" WideMode="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt2" Height="24" WideMode="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt3" Height="24" WideMode="True" />
                            <controls:LpgmIntensityIcon Intensity="LpgmInt4" Height="24" WideMode="True" />
                            <controls:LpgmIntensityIcon Intensity="Error" Height="24" WideMode="True" />
                        </StackPanel>
                    </StackPanel>

                    <ui:SettingsExpanderItem Content="階級0">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt0Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt0Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt0Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>

                    <ui:SettingsExpanderItem Content="階級1">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt1Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt1Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt1Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="階級2">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt2Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt2Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt2Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="階級3">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt3Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt3Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt3Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                    
                    <ui:SettingsExpanderItem Content="階級4">
                        <ui:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="文字:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt4Foreground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="背景:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt4Background, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                                <TextBlock Text="縁:" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding LpgmInt4Border, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                            </StackPanel>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                </ui:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
