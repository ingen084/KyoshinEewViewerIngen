<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:wf="clr-namespace:KyoshinEewViewer.Series.Tsunami.Workflow;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="350"
             x:DataType="wf:TsunamiInformationTrigger" x:CompileBindings="True"
             x:Class="KyoshinEewViewer.Series.Tsunami.Workflow.TsunamiInformationTriggerControl">
    <StackPanel>
        <WrapPanel>
            <CheckBox IsChecked="{Binding EnableIssued}" Content="発表" Margin="0,2,10,2"
                      ToolTip.Tip="未発表状態から津波情報が発表されたとき" />
            <CheckBox IsChecked="{Binding EnableUpgraded}" Content="警報レベル上昇" Margin="0,2,10,2"
                      ToolTip.Tip="より上位の警報に切り替えられたとき" />
            <CheckBox IsChecked="{Binding EnableDowngraded}" Content="警報レベル下降・解除" Margin="0,2,10,2"
                      ToolTip.Tip="警報レベルが下がったり解除されたとき" />
            <CheckBox IsChecked="{Binding EnableUpdated}" Content="その他更新" Margin="0,2,10,2"
                      ToolTip.Tip="地域の増減など、上記以外の情報更新時" />
        </WrapPanel>
    </StackPanel>
</UserControl>
