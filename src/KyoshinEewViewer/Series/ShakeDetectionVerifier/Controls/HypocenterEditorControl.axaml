<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:KyoshinEewViewer.Series.ShakeDetectionVerifier.Controls"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="300"
             x:Class="KyoshinEewViewer.Series.ShakeDetectionVerifier.Controls.HypocenterEditorControl"
             x:DataType="local:HypocenterEditorControl"
             x:Name="Root">

	<StackPanel Spacing="8">
		<!-- ヘッダー -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0" Text="手動震源設定" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
			<ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.IsEnabled}" OffContent="" OnContent=""/>
		</Grid>

		<!-- 編集フィールド -->
		<StackPanel Spacing="6" IsEnabled="{Binding #Root.IsEnabled}">
			<!-- 緯度 -->
			<Grid ColumnDefinitions="80,*">
				<TextBlock Grid.Column="0" Text="緯度" VerticalAlignment="Center"/>
				<ui:NumberBox Grid.Column="1"
					Value="{Binding #Root.Latitude}"
					Minimum="20" Maximum="50"
					SmallChange="0.1" LargeChange="1"
					SpinButtonPlacementMode="Compact"/>
			</Grid>

			<!-- 経度 -->
			<Grid ColumnDefinitions="80,*">
				<TextBlock Grid.Column="0" Text="経度" VerticalAlignment="Center"/>
				<ui:NumberBox Grid.Column="1"
					Value="{Binding #Root.Longitude}"
					Minimum="120" Maximum="155"
					SmallChange="0.1" LargeChange="1"
					SpinButtonPlacementMode="Compact"/>
			</Grid>

			<!-- 深さ -->
			<Grid ColumnDefinitions="80,*">
				<TextBlock Grid.Column="0" Text="深さ (km)" VerticalAlignment="Center"/>
				<ui:NumberBox Grid.Column="1"
					Value="{Binding #Root.DepthKm}"
					Minimum="0" Maximum="700"
					SmallChange="10" LargeChange="50"
					SpinButtonPlacementMode="Compact"/>
			</Grid>

			<!-- 発震時刻オフセット -->
			<Grid ColumnDefinitions="80,*">
				<TextBlock Grid.Column="0" Text="発震Δ (秒)" VerticalAlignment="Center"/>
				<ui:NumberBox Grid.Column="1"
					Value="{Binding #Root.OriginTimeOffsetSeconds}"
					Minimum="-60" Maximum="60"
					SmallChange="0.5" LargeChange="5"
					SpinButtonPlacementMode="Compact"/>
			</Grid>

			<!-- 基準時刻表示 -->
			<StackPanel Orientation="Horizontal" Spacing="8">
				<TextBlock Text="発震時刻:" FontSize="11"/>
				<TextBlock Text="{Binding #Root.OriginTimeText}" FontSize="11" FontWeight="SemiBold"/>
			</StackPanel>

			<!-- 残差統計 -->
			<Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
				CornerRadius="4" Padding="8" Margin="0,4,0,0">
				<StackPanel Spacing="4">
					<TextBlock Text="残差統計" FontWeight="SemiBold" FontSize="12"/>
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="残差標準偏差:" FontSize="11"/>
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding #Root.ResidualStdDevText}" FontSize="11" HorizontalAlignment="Right"/>

						<TextBlock Grid.Row="1" Grid.Column="0" Text="残差平均:" FontSize="11"/>
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding #Root.ResidualMeanText}" FontSize="11" HorizontalAlignment="Right"/>

						<TextBlock Grid.Row="2" Grid.Column="0" Text="使用観測点数:" FontSize="11"/>
						<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding #Root.UsedStationCount}" FontSize="11" HorizontalAlignment="Right"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- 未検知ペナルティ -->
			<Border Background="{DynamicResource SubtleFillColorTertiaryBrush}"
				CornerRadius="4" Padding="8" Margin="0,4,0,0">
				<StackPanel Spacing="4">
					<TextBlock Text="未検知ペナルティ" FontWeight="SemiBold" FontSize="12"/>
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="ペナルティ値:" FontSize="11"/>
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding #Root.UndetectedPenaltyText}" FontSize="11" HorizontalAlignment="Right"/>

						<TextBlock Grid.Row="1" Grid.Column="0" Text="詳細:" FontSize="10" Foreground="{DynamicResource SubForegroundColor}"/>
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding #Root.UndetectedDetailsText}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource SubForegroundColor}"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- ボタン -->
			<Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
				<Button Grid.Column="0" Content="自動推定から取得"
					Command="{Binding #Root.ApplyFromEstimated}"
					HorizontalAlignment="Stretch" Margin="0,0,2,0"/>
				<Button Grid.Column="1" Content="残差を再計算"
					Command="{Binding #Root.RecalculateResiduals}"
					HorizontalAlignment="Stretch" Margin="2,0,0,0"/>
			</Grid>
		</StackPanel>
	</StackPanel>
</UserControl>
