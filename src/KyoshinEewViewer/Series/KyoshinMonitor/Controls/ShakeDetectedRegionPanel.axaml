<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:KyoshinEewViewer.Series.KyoshinMonitor.Models;assembly=KyoshinEewViewer"
             xmlns:self="clr-namespace:KyoshinEewViewer.Series.KyoshinMonitor.Controls;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:CompileBindings="True" x:DataType="self:ShakeDetectedRegionPanel"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.Controls.ShakeDetectedRegionPanel">
    <UserControl.Styles>
        <Style Selector="Border.header">
            <Setter Property="Background" Value="{DynamicResource DockTitleBackgroundColor}" />
        </Style>
        <Style Selector="Border.header TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubForegroundColor}" />
        </Style>
        <Style Selector="Border.container">
            <Setter Property="Background" Value="{DynamicResource DockBackgroundColor}" />
        </Style>
        <Style Selector="Border.container TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="24,*">
        <Border Classes="header" CornerRadius="4,4,0,0">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=self:ShakeDetectedRegionPanel}}"
                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="1" Classes="container" CornerRadius="0,0,4,4">
            <ItemsControl ItemsSource="{Binding Regions, RelativeSource={RelativeSource AncestorType=self:ShakeDetectedRegionPanel}}" Margin="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ShakeDetectedRegion">
                        <StackPanel Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="(全域)" VerticalAlignment="Bottom"
                                            IsVisible="{Binding IsFullRegion}"
                                            FontSize="16"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SubRegions}" Margin="10,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="16" Margin="0,0,5,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
