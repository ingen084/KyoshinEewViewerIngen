<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:KyoshinEewViewer.Series.KyoshinMonitor.SettingPages"
			 xmlns:cc="using:KyoshinEewViewer.CustomControl"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
			 x:DataType="vm:ObservationPointsDataPageViewModel"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.SettingPages.ObservationPointsDataPage">
	<UserControl.Styles>
		<Style Selector="Label">
			<Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
		</Style>
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="cc|SettingsExpander">
			<Setter Property="Margin" Value="10,3,10,0" />
		</Style>
	</UserControl.Styles>
	<ScrollViewer>
		<StackPanel>
			<cc:SettingsExpander Header="観測点情報の自動更新" Description="起動時に新しい観測点情報を自動的にダウンロードします。" IconGlyph="&#xf021;">
				<cc:SettingsExpander.Footer>
					<ToggleSwitch IsChecked="{Binding Config.KyoshinMonitor.AutoUpdateObservationPoints}" OnContent="有効" OffContent="無効" />
				</cc:SettingsExpander.Footer>
			</cc:SettingsExpander>

			<TextBlock Text="現在のデータ情報" FontWeight="Bold" Margin="10,20,10,5" />
			<cc:SettingsExpander Header="データバージョン" Description="使用中の観測点データのバージョンです。" IconGlyph="&#xf05a;">
				<cc:SettingsExpander.Footer>
					<TextBlock Text="{Binding DataVersion}" FontWeight="SemiBold" />
				</cc:SettingsExpander.Footer>
			</cc:SettingsExpander>

			<cc:SettingsExpander Header="作成日時" Footer="{Binding PackedAt}" IconGlyph="&#xf073;">
			</cc:SettingsExpander>

			<cc:SettingsExpander Header="データソース" IconGlyph="&#xf1c0;">
				<cc:SettingsExpander.Footer>
					<TextBlock Text="{Binding Source}" FontSize="12" />
				</cc:SettingsExpander.Footer>
			</cc:SettingsExpander>

			<cc:SettingsExpander Header="観測点数" Footer="{Binding ObservationPointsCount, StringFormat={}{0}点}" IconGlyph="&#xf279;">
			</cc:SettingsExpander>

			<TextBlock Text="更新" FontWeight="Bold" Margin="10,20,10,5" />
			<cc:SettingsExpander Header="手動更新" Description="観測点情報を手動で更新します。" IconGlyph="&#xf2f1;">
				<cc:SettingsExpander.Footer>
					<Button Content="更新" Command="{Binding ManualUpdateCommand}" IsEnabled="{Binding !IsUpdating}" />
				</cc:SettingsExpander.Footer>

				<StackPanel Spacing="5" Margin="0,5">
					<TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" />
					<TextBlock Text="更新を適用するにはアプリケーションの再起動が必要です。" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
				</StackPanel>
			</cc:SettingsExpander>
		</StackPanel>
	</ScrollViewer>
</UserControl>
