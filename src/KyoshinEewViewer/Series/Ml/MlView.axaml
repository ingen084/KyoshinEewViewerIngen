<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:KyoshinEewViewer.Series.Ml;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 Foreground="{DynamicResource ForegroundColor}"
             x:Class="KyoshinEewViewer.Series.Ml.MlView"
			 x:DataType="local:MlSeries" x:CompileBindings="True">
    <Design.DataContext>
        <local:MlSeries />
    </Design.DataContext>

    <Grid>
        <!-- 操作パネル -->
        <Border CornerRadius="4" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource DockBackgroundColor}" Padding="10">
            <StackPanel Spacing="10" Width="250">
                <!-- 警告バナー -->
                <Border CornerRadius="4" Background="{DynamicResource WarningBackgroundColor}">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="&#xf071;" Foreground="{DynamicResource WarningForegroundColor}"
                                   VerticalAlignment="Center" FontSize="16" Classes="icon" />
                        <TextBlock Text="実験目的のツールです" Margin="5,0,0,0"
                                   Foreground="{DynamicResource WarningForegroundColor}" VerticalAlignment="Center"
                                   FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 観測点読み込み -->
                <StackPanel Spacing="5">
                    <TextBlock Text="観測点データ" FontWeight="SemiBold" />
                    <Button Content="観測点ファイルを開く..." Command="{Binding OpenObservationPointFile}"
                            HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding ObservationPoints.Length, StringFormat={}読み込み観測点数: {0}件}"
                               FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
                    <TextBlock Text="{Binding ValidObservationPointCount, StringFormat={}有効観測点数: {0}件}"
                               FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
                </StackPanel>

                <Separator />

                <!-- グリッド設定 -->
                <StackPanel Spacing="5">
                    <TextBlock Text="グリッド設定" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="分割単位:" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding GridUnit}" Minimum="0.001" Maximum="1.0"
                                       Increment="0.01" FormatString="0.###" Width="150" />
                        <TextBlock Text="度" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding GridCount, StringFormat={}グリッド数: {0}個}"
                               FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
