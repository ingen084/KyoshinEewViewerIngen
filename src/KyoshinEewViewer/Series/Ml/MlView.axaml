<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:KyoshinEewViewer.Series.Ml;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 Foreground="{DynamicResource ForegroundColor}"
             x:Class="KyoshinEewViewer.Series.Ml.MlView"
			 x:DataType="local:MlSeries" x:CompileBindings="True">
    <Design.DataContext>
        <local:MlSeries />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">
        <!-- 操作パネル（左上） -->
        <Border Grid.Row="0" CornerRadius="4" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource DockBackgroundColor}" Padding="10">
            <StackPanel Spacing="10" Width="280">
                <!-- 警告バナー -->
                <Border CornerRadius="4" Background="{DynamicResource WarningBackgroundColor}">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="&#xf071;" Foreground="{DynamicResource WarningForegroundColor}"
                                   VerticalAlignment="Center" FontSize="16" Classes="icon" />
                        <TextBlock Text="データセット作成用ツール" Margin="5,0,0,0"
                                   Foreground="{DynamicResource WarningForegroundColor}" VerticalAlignment="Center"
                                   FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- データ読み込み -->
                <StackPanel Spacing="5">
                    <TextBlock Text="データ読み込み" FontWeight="SemiBold" />
                    <Button Content="ファイルを開く..." Command="{Binding OpenReplayFile}"
                            HorizontalAlignment="Stretch" IsEnabled="{Binding !IsLoading}" />
                    <Button Content="ディレクトリを開く..." Command="{Binding OpenReplayDirectory}"
                            HorizontalAlignment="Stretch" IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <Separator />

                <!-- ステータス情報 -->
                <StackPanel Spacing="3">
                    <TextBlock Text="ステータス" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubForegroundColor}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubForegroundColor}"
                               IsVisible="{Binding HasData}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}地震情報: {0}件 (表示中: {1}件)">
                                <Binding Path="TotalEarthquakeCount" />
                                <Binding Path="ActiveEarthquakeCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 読み込み中インジケータ -->
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="4" />
                    <TextBlock Text="読み込み中..." FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubForegroundColor}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 下部パネル（2段スライダーと時刻表示） -->
        <Border Grid.Row="1" Background="{DynamicResource DockBackgroundColor}" Padding="10">
            <Grid RowDefinitions="Auto,Auto">
                <!-- 1段目: 時間スライダー -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="時間:" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="{Binding CurrentHourDisplay}" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" MinWidth="120" />
                    </StackPanel>

                    <Slider Grid.Column="1" Margin="15,0"
                            Minimum="0"
                            Maximum="{Binding HourSliderMaximum}"
                            Value="{Binding HourSliderValue}"
                            IsEnabled="{Binding HasData}"
                            VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HourSliderValue}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="/" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HourSliderMaximum}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="時間" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 2段目: 秒スライダー -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="時刻:" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="{Binding CurrentDisplayTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                   MinWidth="140" />
                    </StackPanel>

                    <Slider Grid.Column="1" Margin="15,0"
                            Minimum="0"
                            Maximum="{Binding SecondSliderMaximum}"
                            Value="{Binding SecondSliderValue}"
                            IsEnabled="{Binding HasData}"
                            VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SecondSliderValue}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="/" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SecondSliderMaximum}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="秒" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
