<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:KyoshinEewViewer.Series.Qzss.Models"
             xmlns:conv="clr-namespace:KyoshinEewViewer.Series.Qzss.Converters"
             Foreground="{DynamicResource ForegroundColor}"
             x:DataType="local:MarineReportGroup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="KyoshinEewViewer.Series.Qzss.Models.MarineReportControl">
    <UserControl.Resources>
        <conv:DCReportConverters x:Key="DCReportConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="auto,*" ColumnDefinitions="240,*">
        <StackPanel>
            <Border Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                <TextBlock Text="JMA-DC Report" FontSize="20" Margin="5,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <Border Background="{DynamicResource DockBackgroundColor}" CornerRadius="0,0,4,4" Margin="0,0,0,5">
                <StackPanel Margin="5,0">
                    <Panel>
                        <TextBlock HorizontalAlignment="Left">
                            <Run Text="分類" FontSize="12" />
                            <Run Text="{Binding Classification, Converter={StaticResource DCReportConverter}, ConverterParameter=ReportClassificationLong, Mode=OneWay}" FontSize="16" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="種別" FontSize="12" />
                            <Run Text="{Binding InformationType, Converter={StaticResource DCReportConverter}, ConverterParameter=InformationType, Mode=OneWay}" FontSize="16" />
                        </TextBlock>
                    </Panel>
                    <Panel>
                        <TextBlock HorizontalAlignment="Left">
                            <Run Text="発表" FontSize="12" />
                            <Run Text="{Binding ReportTime, StringFormat={}M月dd日 HH時mm分, Mode=OneWay}" FontSize="16" />
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="統合数" FontSize="12" />
                            <Run Text="{Binding ReportCount}" FontSize="16" />
                        </TextBlock>
                    </Panel>
                    <Viewbox Height="27" StretchDirection="DownOnly" Stretch="Fill">
                        <TextBlock Text="防災気象情報(海上)" FontSize="18" HorizontalAlignment="Center" />
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                <StackPanel Orientation="Horizontal" Margin="10,0" Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="海上警報" FontWeight="Bold" FontSize="20" />
                    <TextBlock Text="{Binding TotalAreaCount,StringFormat={}{0}地域}" Foreground="{DynamicResource SubForegroundColor}" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Background="{DynamicResource DockBackgroundColor}" Grid.Row="1" CornerRadius="0,0,4,4">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AggregatedRegions}">
                    <ItemsControl.Styles>
                        <Style Selector="ItemsControl>ContentPresenter:nth-last-child(1)>StackPanel>Rectangle.Separator">
                            <Setter Property="IsVisible" Value="False" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding AreaCode, Converter={StaticResource DCReportConverter}, ConverterParameter=Marine}" Margin="5,0" FontWeight="Bold" FontSize="16" />
                                <ItemsControl ItemsSource="{Binding WarningCodes}" Margin="5,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DCReportConverter}, ConverterParameter=MarineWarningCode}" VerticalAlignment="Bottom" Margin="5,0,0,0" FontSize="14" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Classes="Separator" Height="1" Fill="{DynamicResource DockTitleBackgroundColor}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource DockBackgroundColor}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="地図表示未実装" Margin="5" FontSize="28" />
        </Border>
    </Grid>
</UserControl>
