<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:KyoshinEewViewer.Series.Qzss.Models"
             xmlns:conv="clr-namespace:KyoshinEewViewer.Series.Qzss.Converters"
             Foreground="{DynamicResource MainForegroundColor}"
             x:DataType="local:VolcanoReportGroup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="KyoshinEewViewer.Series.Qzss.Models.VolcanoReportControl">
    <UserControl.Resources>
        <conv:DCReportConverters x:Key="DCReportConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="auto,*" ColumnDefinitions="240,*">
        <StackPanel>
            <local:DCReportHeaderControl Title="防災気象情報(火山)" ShowReportCount="True" />

            <Border Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                <TextBlock Text="火山情報" FontWeight="Bold" FontSize="20" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Background="{DynamicResource DockBackgroundColor}">
                <StackPanel Margin="10,5">
                    <TextBlock Text="火山名" FontSize="14" Margin="0,0,0,-16" />
                    <Viewbox Stretch="Fill" StretchDirection="DownOnly" Height="35" MaxWidth="165" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding VolcanoNameCode, Converter={StaticResource DCReportConverter}, ConverterParameter=Volcano}" FontSize="24" FontWeight="Bold" />
                    </Viewbox>

                    <TextBlock Text="時刻" FontSize="14" Margin="0,0,0,-16" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ActivityDateString}" Margin="0,0,0,-2" FontSize="18" VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding ActivityTimeString}" Margin="0,0,0,-3" FontSize="23" VerticalAlignment="Bottom" />
                        <TextBlock Text="頃" FontSize="14" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <TextBlock Text="現象" FontSize="14" Margin="0,0,0,-10" />
                    <Viewbox Stretch="Fill" StretchDirection="DownOnly" Height="35" Margin="5,0,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding WarningCode, Converter={StaticResource DCReportConverter}, ConverterParameter=VolcanicWarningCode}" FontSize="24" FontWeight="Bold" />
                    </Viewbox>
                </StackPanel>
            </StackPanel>
            <Border Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="0,0,4,4">
                <TextBlock
                    Text="{Binding ReportTime, StringFormat=MM月dd日 HH時mm分 発表}" FontSize="14" Margin="10,0"
                    Foreground="{DynamicResource SubForegroundColor}"
                    VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Border>
        </StackPanel>
        <Grid Grid.Row="1" RowDefinitions="auto,*" Margin="0,5,0,0">
            <Border CornerRadius="4,4,0,0" Background="{DynamicResource DockTitleBackgroundColor}">
                <TextBlock Text="地域" FontWeight="Bold" FontSize="18" Margin="10,0" />
            </Border>
            <Border Grid.Row="1" CornerRadius="0,0,4,4" Background="{DynamicResource DockBackgroundColor}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Regions}" Margin="5,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding, Converter={StaticResource DCReportConverter}, ConverterParameter=AreaInformationCity}" FontSize="16" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource DockBackgroundColor}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="地図表示未実装" Margin="5" FontSize="28" />
        </Border>
    </Grid>
</UserControl>
