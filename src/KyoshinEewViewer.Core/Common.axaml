<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">
	<Styles.Resources>
		<FontFamily x:Key="IconFont">resm:KyoshinEewViewer.Core.Assets.Fonts.FontAwesome6Free-Solid-900.otf?assembly=KyoshinEewViewer.Core#Font Awesome 6 Free</FontFamily>
		<FontFamily x:Key="MainFont">resm:KyoshinEewViewer.Core.Assets.Fonts.NotoSansJP?assembly=KyoshinEewViewer.Core#Noto Sans JP</FontFamily>
	</Styles.Resources>
	<Style Selector="TextBlock.icon">
		<Setter Property="FontFamily" Value="{StaticResource IconFont}" />
		<Setter Property="FontWeight" Value="Light" />
	</Style>
	<Style Selector="Run.icon">
		<Setter Property="FontFamily" Value="{StaticResource IconFont}" />
		<Setter Property="FontWeight" Value="Light" />
	</Style>
    <Style Selector="Window">
		<Setter Property="FontFamily" Value="{StaticResource MainFont}" />
		<Setter Property="FontWeight" Value="Regular" />
	</Style>
    <!--
    <Style Selector="ui|FAFontIcon">
        <Setter Property="Width" Value="24" />
    </Style>
    <Style Selector="ui|FASymbolIcon">
        <Setter Property="Width" Value="24" />
    </Style>-->
</Styles>
