<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\common.props" />
    <ItemGroup>
        <AvaloniaResource Include="**\*.axaml" />
        <AvaloniaResource Include="Common.axaml" />
        <AvaloniaResource Include="Assets\**" Exclude="Assets\Fonts\**" />
        <!-- フォントは Skia からコピーなしで参照できるよう、通常の埋め込みリソースにする (KyoshinEewViewerFonts 参照) -->
        <EmbeddedResource Include="Assets\Fonts\**" />
    </ItemGroup>

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="MessagePack" Version="3.1.9" />
    </ItemGroup>
</Project>
