<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:KyoshinEewViewer.Core"
             x:Class="KyoshinEewViewer.Android.App">
	<Application.Styles>
		<StyleInclude Source="avares://KyoshinEewViewer.Core/Common.axaml" />
		<core:KyoshinEewViewerWindowTheme />
        <core:KyoshinEewViewerIntensityTheme />
		<FluentTheme />
	</Application.Styles>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="設定" Click="OpenSettingsClicked" />
		</NativeMenu>
	</NativeMenu.Menu>
</Application>
