<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cc="using:KyoshinEewViewer.CustomControl">

    <ControlTheme x:Key="{x:Type cc:ContentDialog}" TargetType="cc:ContentDialog">
        <Setter Property="Background" Value="{DynamicResource ContentDialogBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentDialogForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentDialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MaxWidth" Value="548" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- 暗幕 -->
                <Panel Name="LayoutRoot">
                    <Border Name="SmokeFill"
                            Background="#80000000"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

                    <!-- ダイアログ本体 -->
                    <Border Name="Container"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            MinWidth="{TemplateBinding MinWidth}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BoxShadow="0 8 32 0 #44000000"
                            ClipToBounds="True">
                        <Grid RowDefinitions="*,Auto">
                            <!-- タイトル + コンテンツ -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Auto"
                                         MaxHeight="500">
                                <StackPanel Margin="24">
                                    <ContentPresenter Name="TitlePresenter"
                                                      Content="{TemplateBinding Title}"
                                                      FontSize="20"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,12"
                                                      TextWrapping="Wrap" />

                                    <ContentPresenter Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ボタン行 -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource ContentDialogCommandSpaceBackground}"
                                    BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="24,16">
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <Button Name="PrimaryButton"
                                            Grid.Column="0"
                                            Content="{TemplateBinding PrimaryButtonText}"
                                            HorizontalAlignment="Stretch"
                                            Theme="{StaticResource AccentButton}"
                                            IsVisible="{TemplateBinding PrimaryButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <Button Name="SecondaryButton"
                                            Grid.Column="2"
                                            Content="{TemplateBinding SecondaryButtonText}"
                                            HorizontalAlignment="Stretch"
                                            IsVisible="{TemplateBinding SecondaryButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <Button Name="CloseButton"
                                            Grid.Column="4"
                                            Content="{TemplateBinding CloseButtonText}"
                                            HorizontalAlignment="Stretch"
                                            IsVisible="{TemplateBinding CloseButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
