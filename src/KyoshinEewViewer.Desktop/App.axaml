<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:KyoshinEewViewer.Core"
             x:Class="KyoshinEewViewer.Desktop.App"
             Name="KyoshinEewViewer for ingen">
	<Application.Styles>
		<StyleInclude Source="avares://KyoshinEewViewer.Core/Common.axaml" />
		<core:KyoshinEewViewerWindowTheme />
        <core:KyoshinEewViewerIntensityTheme />
		<FluentTheme />
		<StyleInclude Source="avares://KyoshinEewViewer.CustomControl/Themes/Generic.axaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
	</Application.Styles>

	<Application.Resources>
		<!-- AvaloniaEdit の Fluent テーマが参照するリソース (FluentAvalonia には存在しないため定義) -->
		<SolidColorBrush x:Key="ToolTipBackground" Color="#2D2D30" />
		<SolidColorBrush x:Key="ToolTipForeground" Color="#F1F1F1" />
		<SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3F3F46" />
		<Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
	</Application.Resources>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="設定" Click="OpenSettingsClicked" />
		</NativeMenu>
	</NativeMenu.Menu>
</Application>
