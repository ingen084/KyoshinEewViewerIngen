<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\common.props" />

    <!-- Windows ネイティブ通知 (#if WINDOWS) をビルドするため、Windows ホストでのみ windows TFM に上書きする -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <!-- プロジェクト参照 -->
    <ItemGroup>
        <ProjectReference Include="..\KyoshinEewViewer\KyoshinEewViewer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <!-- 通知アイコン: Linux は .desktop の hicolor 展開用、Windows は Toast の AUMID 登録用に埋め込む -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) or '$(TargetPlatformIdentifier)' == 'Windows'">
        <AvaloniaResource Include="Notification\Assets\net.ingen084.kyoshineewviewer.png" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="App.axaml.cs">
          <DependentUpon>%(Filename)</DependentUpon>
        </Compile>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <Compile Update="Views\MainWindow.axaml.cs">
          <DependentUpon>%(Filename)</DependentUpon>
        </Compile>
        <Compile Update="Views\SplashWindow.axaml.cs">
          <DependentUpon>%(Filename)</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Update="libs\linux-x64\libbass.so" Condition="$(RuntimeIdentifier)=='' or $(RuntimeIdentifier)=='linux-x64'">
            <Link>libbass.so</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="libs\linux-arm64\libbass.so" Condition="$(RuntimeIdentifier)=='' or $(RuntimeIdentifier)=='linux-arm64'">
            <Link>libbass.so</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="libs\osx\libbass.dylib" Condition="$(RuntimeIdentifier)=='' or $(RuntimeIdentifier.StartsWith('osx'))">
            <Link>libbass.dylib</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="libs\win-x64\bass.dll" Condition="$(RuntimeIdentifier)=='' or $(RuntimeIdentifier)=='win-x64'">
            <Link>bass.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="libs\win-arm64\bass.dll" Condition="$(RuntimeIdentifier)=='win-arm64'">
            <Link>bass.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
