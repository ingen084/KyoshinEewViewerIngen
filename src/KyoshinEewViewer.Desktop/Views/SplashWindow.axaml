<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KyoshinEewViewer.Desktop.Views.SplashWindow"
		
		WindowStartupLocation="CenterScreen"
		WindowDecorations="None"
		Width="620" Height="300"
        CanResize="False"
		Topmost="True"
		
        Title="起動中 - KyoshinEewViewer for ingen">
	<Panel x:Name="SplashPanel">
		<Image x:Name="SplashImage" Source="/Assets/splash.png" AutomationProperties.Name="Kyoshin Eew Viewer 起動中" />
	</Panel>
</Window>
