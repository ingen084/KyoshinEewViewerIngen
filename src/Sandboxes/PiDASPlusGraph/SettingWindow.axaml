<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:core="using:KyoshinEewViewer.Core"
        x:Class="PiDASPlusGraph.SettingWindow"
        Title="設定 - PiDASPlusGraph"
        Width="500" Height="480" MinWidth="400" MinHeight="400"
        Background="{DynamicResource MainBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
        WindowStartupLocation="CenterOwner">
	<Window.Styles>
		<Style Selector="ui|FASettingsExpander">
			<Setter Property="Margin" Value="10,3,10,0" />
		</Style>
	</Window.Styles>
	<ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,10">
            <TextBlock Text="外観" FontWeight="Bold" Margin="10,0,10,5" />

            <ui:FASettingsExpander Header="ウィンドウテーマ" Description="全体的な配色を変更します">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf53f;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ComboBox x:Name="ThemeComboBox" MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ThemeSelector+WindowTheme">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Theme.Name}" />
                                    <TextBlock Text="{Binding Meta.DisplayName}" FontSize="12"
                                            Foreground="{DynamicResource SubForegroundColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="震度テーマ" Description="震度アイコンの配色を変更します">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf53f;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ComboBox x:Name="IntensityThemeComboBox" MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ThemeSelector+IntensityTheme">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Theme.Name}" />
                                    <TextBlock Text="{Binding Meta.DisplayName}" FontSize="12"
                                            Foreground="{DynamicResource SubForegroundColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <TextBlock Text="グラフ設定" FontWeight="Bold" Margin="10,15,10,5" />

            <ui:FASettingsExpander Header="波形の保存期間" Description="加速度グラフに表示する期間を設定します">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf017;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <DockPanel MinWidth="250">
                        <TextBlock x:Name="WaveformSecondsText" Text="10秒"
                                TextAlignment="Right" VerticalAlignment="Center" Width="50" DockPanel.Dock="Right" />
                        <Slider x:Name="WaveformSecondsSlider"
                                Minimum="5" Maximum="60" Value="10"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" />
                    </DockPanel>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="加速度グラフを3軸に分離" Description="X/Y/Z軸を個別のグラフで表示します">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf080;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch x:Name="SplitAxesToggle" OnContent="する" OffContent="しない" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <TextBlock Text="ボード設定" FontWeight="Bold" Margin="10,15,10,5" />

            <ui:FASettingsExpander x:Name="DisplayConfigExpander" Header="ボードの表示設定"
                                Description="設定を取得中…" IsEnabled="False" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf108;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="現在震度の表示閾値"
                                        Description="この震度階級以上の場合に現在の震度を表示します">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="CurrentThresholdComboBox" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="最大震度の表示閾値"
                                        Description="この震度階級以上の場合に最大震度を表示します">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="MaxThresholdComboBox" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="最大震度のリセット時間"
                                        Description="最大震度がリセットされるまでの時間(分)">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown x:Name="ResetMinutesUpDown" Minimum="1" Maximum="1440"
                                    FormatString="0" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem.Footer>
                        <Button x:Name="SendDisplayConfigButton" Content="送信" Classes="accent"
                                HorizontalAlignment="Right" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FAInfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="注意"
                        Message="使用している機器は気象庁の検定を受けたものではなく、表示されているデータは公式な記録ではありません。あくまで設置環境における参考値です。"
                        Margin="10,15,10,0" />
        </StackPanel>
	</ScrollViewer>
</Window>
