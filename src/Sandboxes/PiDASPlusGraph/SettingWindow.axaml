<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="using:KyoshinEewViewer.CustomControl"
        xmlns:core="using:KyoshinEewViewer.Core"
        x:Class="PiDASPlusGraph.SettingWindow"
        Title="設定 - PiDASPlusGraph"
        Width="500" Height="480" MinWidth="400" MinHeight="400"
        Background="{DynamicResource MainBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
        WindowStartupLocation="CenterOwner">
	<Window.Styles>
		<Style Selector="cc|SettingsExpander">
			<Setter Property="Margin" Value="10,3,10,0" />
		</Style>
	</Window.Styles>
	<ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,10">
            <TextBlock Text="外観" FontWeight="Bold" Margin="10,0,10,5" />

            <cc:SettingsExpander Header="ウィンドウテーマ" Description="全体的な配色を変更します" IconGlyph="&#xf53f;">
                <cc:SettingsExpander.Footer>
                    <ComboBox x:Name="ThemeComboBox" MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ThemeSelector+WindowTheme">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Theme.Name}" />
                                    <TextBlock Text="{Binding Meta.DisplayName}" FontSize="12"
                                            Foreground="{DynamicResource SubForegroundColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </cc:SettingsExpander.Footer>
            </cc:SettingsExpander>

            <cc:SettingsExpander Header="震度テーマ" Description="震度アイコンの配色を変更します" IconGlyph="&#xf53f;">
                <cc:SettingsExpander.Footer>
                    <ComboBox x:Name="IntensityThemeComboBox" MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ThemeSelector+IntensityTheme">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Theme.Name}" />
                                    <TextBlock Text="{Binding Meta.DisplayName}" FontSize="12"
                                            Foreground="{DynamicResource SubForegroundColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </cc:SettingsExpander.Footer>
            </cc:SettingsExpander>

            <TextBlock Text="グラフ設定" FontWeight="Bold" Margin="10,15,10,5" />

            <cc:SettingsExpander Header="波形の保存期間" Description="加速度グラフに表示する期間を設定します" IconGlyph="&#xf017;">
                <cc:SettingsExpander.Footer>
                    <DockPanel MinWidth="250">
                        <TextBlock x:Name="WaveformSecondsText" Text="10秒"
                                TextAlignment="Right" VerticalAlignment="Center" Width="50" DockPanel.Dock="Right" />
                        <Slider x:Name="WaveformSecondsSlider"
                                Minimum="5" Maximum="60" Value="10"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" />
                    </DockPanel>
                </cc:SettingsExpander.Footer>
            </cc:SettingsExpander>

            <cc:SettingsExpander Header="加速度グラフを3軸に分離" Description="X/Y/Z軸を個別のグラフで表示します" IconGlyph="&#xf080;">
                <cc:SettingsExpander.Footer>
                    <ToggleSwitch x:Name="SplitAxesToggle" OnContent="する" OffContent="しない" />
                </cc:SettingsExpander.Footer>
            </cc:SettingsExpander>

            <TextBlock Text="ボード設定" FontWeight="Bold" Margin="10,15,10,5" />

            <cc:SettingsExpander x:Name="DisplayConfigExpander" Header="ボードの表示設定"
                                Description="設定を取得中…" IsEnabled="False" IsExpanded="True" IconGlyph="&#xf108;">
                <cc:SettingsExpanderItem Content="現在震度の表示閾値"
                                        Description="この震度階級以上の場合に現在の震度を表示します">
                    <cc:SettingsExpanderItem.Footer>
                        <ComboBox x:Name="CurrentThresholdComboBox" MinWidth="120" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>
                <cc:SettingsExpanderItem Content="最大震度の表示閾値"
                                        Description="この震度階級以上の場合に最大震度を表示します">
                    <cc:SettingsExpanderItem.Footer>
                        <ComboBox x:Name="MaxThresholdComboBox" MinWidth="120" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>
                <cc:SettingsExpanderItem Content="最大震度のリセット時間"
                                        Description="最大震度がリセットされるまでの時間(分)">
                    <cc:SettingsExpanderItem.Footer>
                        <NumericUpDown x:Name="ResetMinutesUpDown" Minimum="1" Maximum="1440"
                                    FormatString="0" MinWidth="120" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>
                <cc:SettingsExpanderItem>
                    <cc:SettingsExpanderItem.Footer>
                        <Button x:Name="SendDisplayConfigButton" Content="送信" Classes="accent"
                                HorizontalAlignment="Right" />
                    </cc:SettingsExpanderItem.Footer>
                </cc:SettingsExpanderItem>
            </cc:SettingsExpander>

            <cc:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="注意"
                        Message="使用している機器は気象庁の検定を受けたものではなく、表示されているデータは公式な記録ではありません。あくまで設置環境における参考値です。"
                        Margin="10,15,10,0" />
        </StackPanel>
	</ScrollViewer>
</Window>
