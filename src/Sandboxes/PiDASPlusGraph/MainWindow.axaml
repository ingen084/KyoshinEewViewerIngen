<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:KyoshinEewViewer.CustomControl;assembly=KyoshinEewViewer.CustomControl"
        xmlns:local="clr-namespace:PiDASPlusGraph;assembly=PiDASPlusGraph"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
		MinWidth="300" MinHeight="400" Width="500" Height="600"
        x:Class="PiDASPlusGraph.MainWindow"
        Title="PiDASPlusGraph" Background="{DynamicResource MainBackgroundColor}" Foreground="{DynamicResource ForegroundColor}">
	<Grid RowDefinitions="auto,230,*" Margin="5">
		<Border Background="{DynamicResource ExpanderHeaderBackground}"
		        Padding="8,6" BorderThickness="1" BorderBrush="#19000000" CornerRadius="4">
			<Grid ColumnDefinitions="*,auto">
				<TextBlock x:Name="HwInfoText" Text="ボード情報: 未取得"
				           VerticalAlignment="Center" FontSize="11"
				           Foreground="{DynamicResource SubForegroundColor}"
				           TextTrimming="CharacterEllipsis" Margin="0,0,5,0" />
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="3" Grid.Column="1">
					<ComboBox x:Name="SelectDeviceBox" Width="100" VerticalAlignment="Center" />
					<Button x:Name="DevicesUpdateButton" ToolTip.Tip="デバイス一覧を更新"
					        Width="32" Height="32" Padding="0"
					        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
						<TextBlock Text="&#xf021;" FontFamily="{StaticResource IconFont}" FontSize="14" />
					</Button>
					<Button x:Name="ConnectButton" Classes="primary" ToolTip.Tip="接続"
					        Width="32" Height="32" Padding="0"
					        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
						<TextBlock x:Name="ConnectButtonIcon" Text="&#xf0c1;" FontFamily="{StaticResource IconFont}" FontSize="14" />
					</Button>
					<Button x:Name="SettingButton" ToolTip.Tip="設定"
					        Width="32" Height="32" Padding="0"
					        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
						<TextBlock Text="&#xf013;" FontFamily="{StaticResource IconFont}" FontSize="14" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>
		<Grid ColumnDefinitions="150,*" Grid.Row="1" Margin="5">
			<StackPanel Spacing="5" Margin="0,0,10,0">
				<StackPanel>
					<TextBlock Text="--/-- --:--:--" x:Name="TimeText" HorizontalAlignment="Center" FontSize="15" />
					<controls:IntensityIcon x:Name="Intensity" Intensity="Unknown" WideMode="true" CornerRound="true" Height="70" HorizontalAlignment="Center" />
				</StackPanel>
				<Panel>
					<Rectangle Fill="Red" Width="5" HorizontalAlignment="Left" />
					<TextBlock Text="計測震度 :" Margin="10,0" />
					<TextBlock Text="-n.n" x:Name="RawIntText" HorizontalAlignment="Right" />
				</Panel>
				<Panel Margin="0,-5">
					<TextBlock Text="PGA:" Margin="10,0" />
					<TextBlock Text="-gal" x:Name="PgaText" HorizontalAlignment="Right" />
				</Panel>
				<Grid ColumnDefinitions="10,30,10,*" RowDefinitions="auto,auto,auto,auto,auto">
					<TextBlock Text="加速度" Grid.ColumnSpan="2" />

					<Rectangle Fill="Tomato" Grid.Row="2" Width="5" HorizontalAlignment="Left" />
					<TextBlock Text="X軸" Grid.Column="1" Grid.Row="2" />
					<TextBlock Text=":" Grid.Column="2" Grid.Row="2" />
					<TextBlock Text="000.000gal" x:Name="AccXText" HorizontalAlignment="Right" Grid.Column="3" Grid.Row="2" />

					<Rectangle Fill="DarkCyan" Grid.Row="3" Width="5" HorizontalAlignment="Left" />
					<TextBlock Text="Y軸" Grid.Column="1" Grid.Row="3" />
					<TextBlock Text=":" Grid.Column="2" Grid.Row="3" />
					<TextBlock Text="000.000gal" x:Name="AccYText" HorizontalAlignment="Right" Grid.Column="3" Grid.Row="3" />

					<Rectangle Fill="Orange" Grid.Row="4" Width="5" HorizontalAlignment="Left" />
					<TextBlock Text="Z軸" Grid.Column="1" Grid.Row="4" />
					<TextBlock Text=":" Grid.Column="2" Grid.Row="4" />
					<TextBlock Text="000.000gal" x:Name="AccZText" HorizontalAlignment="Right" Grid.Column="3" Grid.Row="4" />
				</Grid>
			</StackPanel>
			<Border Grid.Column="1" Background="{DynamicResource ExpanderHeaderBackground}" BorderBrush="#19000000" CornerRadius="4" Padding="5" BorderThickness="1">
				<local:GraphControl x:Name="IntensityGraph" IsIntensityGrid="True" MinValue="-1" MaxValue="8" ClipToBounds="True" />
			</Border>
		</Grid>
		<Border x:Name="CombinedAccPanel" Grid.Row="2" Margin="5" Background="{DynamicResource ExpanderHeaderBackground}" BorderBrush="#19000000" CornerRadius="4" Padding="5" BorderThickness="1">
			<local:GraphControl x:Name="AccGraph" IsAutoRange="True" MinValue="-1" MaxValue="1" ClipToBounds="True" />
		</Border>
		<Grid x:Name="SplitAccPanel" Grid.Row="2" Margin="5" RowDefinitions="*,2,*,2,*" IsVisible="False">
			<Border Background="{DynamicResource ExpanderHeaderBackground}" BorderBrush="#19000000" CornerRadius="4" Padding="5" BorderThickness="1">
				<Panel>
					<local:GraphControl x:Name="AccXGraph" IsAutoRange="True" MinValue="-1" MaxValue="1" ClipToBounds="True" />
					<TextBlock Text="X" Foreground="Tomato" FontWeight="Bold" FontSize="14" Margin="0,-5" HorizontalAlignment="Left" VerticalAlignment="Top" />
				</Panel>
			</Border>
			<Border Grid.Row="2" Background="{DynamicResource ExpanderHeaderBackground}" BorderBrush="#19000000" CornerRadius="4" Padding="5" BorderThickness="1">
				<Panel>
					<local:GraphControl x:Name="AccYGraph" IsAutoRange="True" MinValue="-1" MaxValue="1" ClipToBounds="True" />
					<TextBlock Text="Y" Foreground="DarkCyan" FontWeight="Bold" FontSize="14" Margin="0,-5" HorizontalAlignment="Left" VerticalAlignment="Top" />
				</Panel>
			</Border>
			<Border Grid.Row="4" Background="{DynamicResource ExpanderHeaderBackground}" BorderBrush="#19000000" CornerRadius="4" Padding="5" BorderThickness="1">
				<Panel>
					<local:GraphControl x:Name="AccZGraph" IsAutoRange="True" MinValue="-1" MaxValue="1" ClipToBounds="True" />
					<TextBlock Text="Z" Foreground="Orange" FontWeight="Bold" FontSize="14" Margin="0,-5" HorizontalAlignment="Left" VerticalAlignment="Top" />
				</Panel>
			</Border>
		</Grid>
		<Border x:Name="AdjustPanel" IsVisible="False" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource DockBackgroundColor}" CornerRadius="4">
			<TextBlock Text="センサー調整中…" x:Name="AdjustText" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
		</Border>
		<Grid x:Name="Hitbox" IsHitTestVisible="False" Grid.RowSpan="3" Background="#00000000" />
	</Grid>
</Window>
