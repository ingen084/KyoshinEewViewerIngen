# 観測点データファイルのパス（必須）
# .kmop ファイルのパス、またはHTTP(S) URLを指定
OBSERVATION_POINTS_PATH=/path/to/observation-points.kmop

# タイマーオフセット（ミリ秒）
# 強震モニタのデータ更新タイミングに合わせて調整
TIMER_OFFSET_MS=1100

# OpenTelemetry設定
# Tempoへの接続エンドポイント（トレース・メトリクス）
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# サービス名
OTEL_SERVICE_NAME=shake-detection-producer

# サーバーポート（ヘルスチェック用）
PORT=5000

# Kafka設定
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=shake-detect-events
